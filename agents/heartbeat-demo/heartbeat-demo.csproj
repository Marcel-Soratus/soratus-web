<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Soratus.Agents.HeartbeatDemo</RootNamespace>
    <!-- De assemblynaam is tegelijk de standaard-agentnaam als SORATUS_AGENT__NAME ontbreekt. -->
    <AssemblyName>heartbeat-demo</AssemblyName>
    <!-- In de pijplijn gestempeld; hier een vaste waarde zodat het portaal iets echts toont. -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0-demo</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Soratus.Agents.Telemetry\Soratus.Agents.Telemetry.csproj" />
  </ItemGroup>

</Project>
