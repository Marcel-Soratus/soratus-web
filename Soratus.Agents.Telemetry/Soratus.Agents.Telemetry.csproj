<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Soratus.Agents.Telemetry</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!--
      De Cosmos-SDK levert Newtonsoft.Json sinds 3.6x niet meer zelf mee en eist een expliciete
      verwijzing. Wij serialiseren met System.Text.Json, maar de SDK gebruikt Newtonsoft nog op
      interne paden; die verwijzing wegwuiven zou het probleem verplaatsen naar runtime.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soratus.Agents.Contracts\Soratus.Agents.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      De knip op msg en de UTC-normalisatie zitten in internal typen, omdat ze geen deel van de
      publieke API zijn. Ze zijn wel precies wat getest moet worden: het zijn de twee dingen die
      stil fout kunnen gaan. Het testproject mag er daarom bij.
    -->
    <InternalsVisibleTo Include="Soratus.Agents.Telemetry.Tests" />
  </ItemGroup>

</Project>
