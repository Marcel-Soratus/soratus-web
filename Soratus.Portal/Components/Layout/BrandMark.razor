@* Het drie-stippen-merkteken. Geometrie 1:1 uit Soratus.Web/wwwroot/brand/logo-mark.svg,
   kleuren via de tokens --mark-1 / --mark-2 / --mark-3 (§8). *@

<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 32 32"
     width="@Size"
     height="@Size"
     role="img"
     aria-label="Soratus"
     class="brand-mark">
    <circle cx="6" cy="26" r="3" fill="var(--mark-1)" />
    <circle cx="16" cy="16" r="4" fill="var(--mark-2)" />
    <circle cx="26" cy="6" r="5" fill="var(--mark-3)" />
</svg>

@code {
    /// <summary>Breedte en hoogte in pixels. 20px in de header.</summary>
    [Parameter]
    public int Size { get; set; } = 20;
}
