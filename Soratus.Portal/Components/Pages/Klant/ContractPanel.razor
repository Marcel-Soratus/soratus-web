    /// <summary>De slug van de klant. Komt uit de route van de pagina.</summary>
    [Parameter]
    [EditorRequired]
    public string CustomerId { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool HasChanges => _fields != _original;

    private bool HasCustomerChanges => _customer != _customerOriginal;

    /// <summary>
    /// Het e-mailadres van het toegangsformulier.
    /// </summary>
    /// <remarks>
    /// Een eigenschap en geen veld, om één reden: bij het typen van een nieuw adres hoort de
    /// uitkomst van de vorige poging te verdwijnen. De contractkaart heeft dat niet nodig — die
    /// draagt <c>Dirty</c>, en FormCard laat "Nog niet bewaard" dan vóór "✓ Bewaard" gaan. Dit
    /// formulier legt elke keer iets nieuws vast en heeft geen dirty-stand, dus zou "✓ Bewaard"
    /// naast een half getypt adres blijven staan.
    /// </remarks>
    private string? Email
    {
        get => _email;
        set
        {
            _email = value;

            if (_grantState is FormSaveState.Saved or FormSaveState.Failed)
            {
                _grantState = FormSaveState.Idle;
                _grantError = null;
                _emailError = null;
                _listNotice = null;
                _listError = null;
            }
        }
    }

    private int FieldErrors =>
        (_hoursError is null ? 0 : 1) + (_rateError is null ? 0 : 1) + (_surchargeError is null ? 0 : 1);

    /// <summary>De regel rechts in de kaartkop: waar dit contract vandaan komt.</summary>
    private string Origin
    {
        get
        {
            if (!_hasContract)
            {
                return "nog niet vastgelegd";
            }

            return _changedAt is { } moment
                ? $"gewijzigd {TimeFormat.Clock(moment)}{By(_changedBy)}"
                : "vastgelegd";
        }
    }

    private string OriginTitle =>
        _changedAt is { } moment
            ? TimeFormat.Absolute(moment)
            : "er is nog geen contractdocument voor deze klant";

    /// <summary>
    /// De uitleg onder het tariefveld. Voor de interne beheerklant staat er wat de klantweergave
    /// van dit bedrag maakt, zodat een operator niet denkt dat het wordt doorbelast.
    /// </summary>
    /// <remarks>
    /// Hier stond "Leeg of nul betekent: geen tarief buiten de bundel." Dat was waar zolang het veld
    /// een <c>decimal</c> was en leeg als nul werd bewaard, en het is nu onwaar: leeg en nul zijn
    /// twee waarden en de contractkaart van de klant zegt er twee verschillende dingen over. Een
    /// uitleg die de oude vorm beschrijft is erger dan geen uitleg, want de operator vult op grond
    /// van deze regel iets in.
    /// </remarks>
    private string RateHint =>
        _view?.IsInternal == true
            ? "Interne beheerklant: de contractkaart leest dit als \"intern — niet doorbelast\"."
            : "Leeg betekent: nog geen tarief afgesproken; de kaart laat het veld dan leeg. Nul "
              + "betekent: uren buiten de bundel worden niet doorbelast.";

    /// <summary>
    /// Wat de operator met dit conflict kan doen. Beide uitwegen staan er, want een melding zonder
    /// uitweg is alleen een mededeling.
    /// </summary>
    private const string ConflictHint =
        "Het formulier staat nu op de versie van de ander. Klik Bewaren om jouw waarden alsnog "
        + "vast te leggen — dan overschrijf je wat hier onder \"nu\" staat — of neem zijn versie "
        + "over met de knop bij het formulier.";

    /// <summary>Dezelfde uitweg, voor het klantdocument.</summary>
    /// <remarks>
    /// Eigen tekst en niet dezelfde constante: hij verwijst naar een andere kaart, en "de knop bij
    /// het formulier" zou anders naar het contract wijzen terwijl de botsing op de omgeving zat.
    /// </remarks>
    private const string CustomerConflictHint =
        "Het omgevingsblok staat nu op de versie van de ander. Klik Omgeving bewaren om jouw "
        + "waarden alsnog vast te leggen — dan overschrijf je wat hier onder \"nu\" staat — of neem "
        + "zijn versie over met de knop bij dat blok.";

    /// <summary>De regel rechts in de kop van het omgevingsblok: waar dit klantdocument vandaan komt.</summary>
    private string CustomerOrigin
    {
        get
        {
            if (!_hasCustomerDocument)
            {
                return "nog geen klantdocument";
            }

            return _customerChangedAt is { } moment
                ? $"gewijzigd {TimeFormat.Clock(moment)}{By(_customerChangedBy)}"
                : "vastgelegd";
        }
    }

    private string CustomerOriginTitle =>
        _customerChangedAt is { } moment
            ? TimeFormat.Absolute(moment)
            : "er is nog geen klantdocument voor deze klant; het staat alleen in de configuratie";

    /// <summary>
    /// Of dit een klantomgeving of de interne beheeromgeving is, in woorden.
    /// </summary>
    /// <remarks>
    /// Als tekst en niet als keuzelijst. Dit bepaalt of er wordt gefactureerd (§4) en is daarmee
    /// geen naamswijziging; <c>SaveCustomerAsync</c> houdt vast wat er op het bestaande document
    /// staat en er is dus geen bewerking waarmee deze waarde omslaat. Een keuzelijst die niets
    /// verandert is precies de knop die dit portaal niet zet.
    /// </remarks>
    /// <summary>
    /// De melding als er precies één van de twee omgevingsvelden is ingevuld, of <c>null</c>.
    /// </summary>
    /// <remarks>
    /// <para><strong>Ze mogen uiteenlopen en dat is geen fout.</strong> <c>envFull</c> is wat een
    /// operator leest en kan meer omvatten dan er wordt gemeten — een klant met twee resource groups
    /// bijvoorbeeld. Wat wél iets betekent is dat er één van de twee is en de ander niet: dan denkt
    /// iemand dat de omgeving is vastgelegd terwijl er niet wordt gemeten, of staat er een meetscope
    /// bij een klant waarvan niemand kan zien waar hij hoort. Vandaar een regel op het scherm en geen
    /// blokkade — een blokkade zou van "mag uiteenlopen" een leugen maken.</para>
    ///
    /// <para>Uit de twee formuliervelden en niet uit de opslag. Zo meldt hij ook wat er net is getypt en
    /// nog niet bewaard, en dat is het moment waarop het nog goedkoop is.</para>
    /// </remarks>
    private string? ScopeMismatch
    {
        get
        {
            var detail = !string.IsNullOrWhiteSpace(_customer.EnvironmentDetail);
            var scope = !string.IsNullOrWhiteSpace(_customer.AzureScope);

            return (detail, scope) switch
            {
                (true, false) =>
                    "Er staat wel een omgeving voor een mens, maar geen Azure-scope. Er worden voor "
                    + "deze klant dus geen kosten gemeten en het facturatiescherm meldt dat er niets "
                    + "is ingericht.",
                (false, true) =>
                    "Er wordt wel gemeten, maar er staat geen omgeving voor een mens. Op de "
                    + "contractkaart en in het overzicht blijft de omgeving van deze klant daarmee "
                    + "leeg.",
                _ => null,
            };
        }
    }

    private string EnvironmentKind => _isInternal
        ? "Interne beheeromgeving van Soratus — niet doorbelast"
        : "Klantomgeving";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            _denied = true;
            return;
        }

        var user = (await AuthenticationState).User;

        // Opnieuw autoriseren, met de gebruiker van dit circuit. De pagina heeft dit al gedaan,
        // maar dat was een ander renderproces en die beslissing reist niet mee.
        _scope = await Scopes.ResolveWriteAsync(user, CustomerId);

        if (_scope is null)
        {
            _denied = true;
            return;
        }

        await LoadAsync();
    }

    /// <summary>
    /// Haalt het contract en de toegangen op en zet het formulier op wat er staat.
    /// </summary>
    private async Task LoadAsync()
    {
        _view = await Contracts.BuildContractAsync(_scope!);

        _fields = From(_view);
        _original = _fields with { };
        _etag = _view.ContractETag;
        _hasContract = _view.HasContract;
        _changedAt = _view.ChangedAt;
        _changedBy = _view.ChangedBy;
        _designations = [.. _view.Roles.Select(role => new FieldOption(role))];

        _customer = EnvironmentFields(_view);
        _customerOriginal = _customer with { };
        _customerETag = _view.CustomerETag;

        // "Er is een klantdocument" is precies het omgekeerde van "deze klant komt alleen uit de
        // configuratie". Twee namen voor één toestand zouden uit elkaar gaan lopen; dit is de
        // enige plek waar de een uit de ander volgt.
        _hasCustomerDocument = !_view.IsFromConfigurationOnly;
        _isInternal = _view.IsInternal;
        _customerChangedAt = _view.CustomerChangedAt;
        _customerChangedBy = _view.CustomerChangedBy;
    }

    /// <summary>
    /// Haalt alleen het overzicht opnieuw op, zonder het formulier aan te raken.
    /// </summary>
    /// <remarks>
    /// Na het geven of intrekken van toegang. Bewust niet het formulier meeverversen: een operator
    /// die net een adres heeft toegevoegd en halverwege het contract was, hoort zijn invoer niet
    /// kwijt te raken. Zijn etag blijft dus ook staan — verandert het contract intussen, dan
    /// merkt hij dat bij het bewaren, met het huidige document erbij.
    /// </remarks>
    private async Task ReloadAccessAsync()
    {
        _view = await Contracts.BuildContractAsync(_scope!);
        _designations = [.. _view.Roles.Select(role => new FieldOption(role))];
    }

    private async Task SaveContractAsync()
    {
        _contractError = null;
        _hoursError = null;
        _rateError = null;
        _surchargeError = null;

        // Parsen hoort bij het scherm: alleen hier is bekend of "8" acht uur of acht procent is.
        // Wat níet hier hoort is de vraag of de waarde mag — dat doet ContractEdit.Validate, en
        // de store roept die aan. Eén definitie van "klopt dit".
        // De invoer gaat mee naar de melding. Bij een duizendscheiding ("1.250") zegt hij dan wat
        // er dubbelzinnig is in plaats van om een getal te vragen terwijl er al een getal staat.
        if (!ContractText.TryNumber(_fields.BundledHours, out var hours))
        {
            _hoursError = ContractText.NumberError("8", _fields.BundledHours);
        }

        if (!ContractText.TryNumber(_fields.HourlyRate, out var rate))
        {
            _rateError = ContractText.NumberError("125,50", _fields.HourlyRate);
        }

        if (!ContractText.TryNumber(_fields.Surcharge, out var surcharge))
        {
            _surchargeError = ContractText.NumberError("8", _fields.Surcharge);
        }

        if (FieldErrors > 0)
        {
            _contractState = FormSaveState.Failed;
            return;
        }

        var edit = new ContractEdit
        {
            Number = NullIfBlank(_fields.Number),
            Type = NullIfBlank(_fields.Type),
            StartsOn = NullIfBlank(_fields.StartsOn),
            Term = NullIfBlank(_fields.Term),
            NoticePeriod = NullIfBlank(_fields.NoticePeriod),
            Sla = NullIfBlank(_fields.Sla),
            BundledHours = hours,
            HourlyRate = rate,
            Indexation = NullIfBlank(_fields.Indexation),
            Contact = NullIfBlank(_fields.Contact),
            ManagedBy = NullIfBlank(_fields.ManagedBy),
            AzureSurchargePercentage = surcharge,
            BasedOnETag = _etag,
        };

        _contractState = FormSaveState.Saving;

        var result = await Store.SaveContractAsync(_scope!, edit);

        switch (result.Status)
        {
            case PortalWriteStatus.Saved:
                var document = result.Value!;

                _etag = document.ETag;
                _hasContract = true;
                _changedAt = document.ChangedAt;
                _changedBy = document.ChangedBy;

                // De opslag is nu de bron: wat daar staat komt terug in het formulier, getrimd en
                // genormaliseerd. Daarmee is "geen wijzigingen" ook waar.
                _fields = From(document);
                _original = _fields with { };
                _conflict = null;
                _changes = [];
                _contractState = FormSaveState.Saved;
                break;

            case PortalWriteStatus.Conflict:
                _conflict = result.Current;
                _changes = _conflict is null ? [] : Changes(_conflict);

                // De etag schuift op naar die van de ander, zodat een tweede klik op Bewaren de
                // eigen waarden alsnog vastlegt. Dat is geen stil overschrijven: de verschillen
                // staan er dan onder, veld voor veld.
                _etag = _conflict?.ETag;
                _hasContract = _conflict is not null;
                _changedAt = _conflict?.ChangedAt;
                _changedBy = _conflict?.ChangedBy;
                _contractError = result.Message;
                _contractState = FormSaveState.Failed;
                break;

            default:
                _contractError = result.Message;
                _contractState = FormSaveState.Failed;
                break;
        }
    }

    /// <summary>
    /// Legt de omgeving van deze klant vast: het klantdocument.
    /// </summary>
    /// <remarks>
    /// Dezelfde vorm als <see cref="SaveContractAsync"/>, en dat is opzet en geen kopieerwerk: de
    /// afhandeling van een botsing hoort op beide kaarten hetzelfde te zijn, want een operator die de
    /// ene heeft geleerd hoort de andere niet opnieuw te hoeven begrijpen. De etag komt van dít blok
    /// en de verschillenkaart komt uit dezelfde <see cref="Differences"/>.
    /// </remarks>
    private async Task SaveCustomerAsync()
    {
        _customerError = null;
        _nameError = null;
        _scopeError = null;

        // De enige harde eis van CustomerEdit, en de melding komt onder het veld dat hem schendt in
        // plaats van als blok boven de knop. Dezelfde functie die de schrijfkant gebruikt zou hier
        // netter zijn, maar CustomerEdit.Validate werpt op een leeg record; de controle staat dus
        // hier én daar, en de store weigert alsnog als deze regel ooit verdwijnt.
        var name = NullIfBlank(_customer.Name);

        if (name is null)
        {
            _nameError =
                "Vul een klantnaam in. Die staat in de kop van elk scherm van deze klant en in het "
                + "overzicht van alle klanten; leeg laten levert daar een lege regel op.";
            _customerState = FormSaveState.Failed;
            return;
        }

        // Dezelfde functie die de schrijfkant gebruikt, en hier alleen om de melding ónder het veld te
        // krijgen dat hem schendt. Zonder deze regel weigert CustomerEdit.Validate hem alsnog, maar dan
        // als blok boven de knop — en dan zoekt een operator welk van de zeven velden hij bedoelt.
        // Dit is geen tweede definitie: het is dezelfde aanroep, twee keer.
        _scopeError = AzureScope.Validate(_customer.AzureScope);

        if (_scopeError is not null)
        {
            _customerState = FormSaveState.Failed;
            return;
        }

        var edit = new CustomerEdit
        {
            Name = name,

            // Geen formulierveld: het gaat mee zodat de schrijfkant hem niet hoeft te verzinnen voor
            // de klant die nog geen document heeft. Bij een klant die er wél een heeft wint wat er
            // staat — zie SaveCustomerAsync in CosmosPortalDataStore.
            IsInternal = _isInternal,
            Environment = NullIfBlank(_customer.Environment),
            EnvironmentDetail = NullIfBlank(_customer.EnvironmentDetail),
            AzureScope = NullIfBlank(_customer.AzureScope),
            TelemetryEndpoint = NullIfBlank(_customer.TelemetryEndpoint),
            TelemetryDatabase = NullIfBlank(_customer.TelemetryDatabase),
            BasedOnETag = _customerETag,
        };

        _customerState = FormSaveState.Saving;

        var result = await Store.SaveCustomerAsync(_scope!, edit);

        switch (result.Status)
        {
            case PortalWriteStatus.Saved:
                var document = result.Value!;

                _customerETag = document.ETag;
                _hasCustomerDocument = true;
                _isInternal = document.IsInternal;
                _customerChangedAt = document.ChangedAt;
                _customerChangedBy = document.ChangedBy;

                _customer = EnvironmentFields(document);
                _customerOriginal = _customer with { };
                _customerConflict = null;
                _customerChanges = [];
                _customerState = FormSaveState.Saved;
                break;

            case PortalWriteStatus.Conflict:
                _customerConflict = result.Current;
                _customerChanges = _customerConflict is null ? [] : Changes(_customerConflict);

                // De etag schuift op naar die van de ander, precies zoals bij het contract: een
                // tweede klik legt de eigen waarden alsnog vast, maar pas nadat de operator heeft
                // gezien wat hij overschrijft.
                _customerETag = _customerConflict?.ETag;
                _hasCustomerDocument = _customerConflict is not null;
                _customerChangedAt = _customerConflict?.ChangedAt;
                _customerChangedBy = _customerConflict?.ChangedBy;
                _customerError = result.Message;
                _customerState = FormSaveState.Failed;
                break;

            default:
                _customerError = result.Message;
                _customerState = FormSaveState.Failed;
                break;
        }
    }

    /// <summary>Zet het omgevingsblok op de waarden die nu in de opslag staan.</summary>
    private void TakeTheirCustomer()
    {
        _customer = _customerConflict is null
            ? new CustomerFields()
            : EnvironmentFields(_customerConflict);
        _customerOriginal = _customer with { };
        _customerETag = _customerConflict?.ETag;
        _hasCustomerDocument = _customerConflict is not null;
        _isInternal = _customerConflict?.IsInternal ?? _isInternal;
        _customerConflict = null;
        _customerChanges = [];
        _customerError = null;
        _customerState = FormSaveState.Idle;
    }

    /// <summary>Zet het formulier op de waarden die nu in de opslag staan.</summary>
    private void TakeTheirs()
    {
        _fields = _conflict is null ? new ContractFields() : From(_conflict);
        _original = _fields with { };
        _etag = _conflict?.ETag;
        _hasContract = _conflict is not null;
        _conflict = null;
        _changes = [];
        _contractError = null;
        _contractState = FormSaveState.Idle;
    }

    private async Task GrantAccessAsync()
    {
        _grantError = null;
        _emailError = null;
        _listNotice = null;
        _listError = null;

        var email = PortalEmail.Normalize(_email);

        // Eerst de controle die bij één veld hoort, zodat de melding onder dat veld komt en niet
        // als blok boven de knop. Dezelfde functie die de schrijfkant gebruikt — een tweede
        // definitie van "geldig adres" zou hier iets doorlaten dat de opslag weigert.
        if (PortalEmail.Validate(email) is { } emailError)
        {
            _emailError = emailError;
            _grantState = FormSaveState.Failed;
            return;
        }

        var grant = new AccessGrant
        {
            Email = email,
            Name = NullIfBlank(_name),
            Role = _designation,
        };

        _grantState = FormSaveState.Saving;

        var result = await Store.GrantAccessAsync(_scope!, grant);

        if (result.IsSaved)
        {
            _email = null;
            _name = null;
            _designation = PortalAccessRoles.Reader;
            _grantState = FormSaveState.Saved;
            _listNotice =
                $"{email} staat in de lijst. Zolang de uitnodiging in Entra ID niet is gedaan, "
                + "komt deze persoon nog niet binnen.";

            await ReloadAccessAsync();
            return;
        }

        _grantError = result.Message;
        _grantState = FormSaveState.Failed;

        // Bij een conflict — dit adres had al toegang — is de lijst op het scherm niet meer waar.
        if (result.Status == PortalWriteStatus.Conflict)
        {
            await ReloadAccessAsync();
        }
    }

    private async Task RevokeAccessAsync(OperatorAccessRow row)
    {
        _listNotice = null;
        _listError = null;

        // De etag van de rij zoals hij op het scherm stond. Zo wordt er niets verwijderd wat
        // intussen is veranderd.
        var result = await Store.RevokeAccessAsync(_scope!, row.Email, row.ETag);

        if (result.IsSaved)
        {
            _listNotice =
                $"{row.Email} staat niet meer in de lijst. De toewijzing in Entra ID blijft "
                + "staan tot iemand hem daar intrekt.";
        }
        else
        {
            _listError = result.Message;
        }

        // Ook na een mislukte poging: de lijst hoort te tonen wat er nú staat.
        await ReloadAccessAsync();
    }

    /// <summary>De contractvelden zoals ze uit het viewmodel komen.</summary>
    private static ContractFields From(OperatorContractView view) => Fields(
        view.Number,
        view.Type,
        ContractText.IsoDate(view.StartsOn),
        view.Term,
        view.NoticePeriod,
        view.Sla,
        view.BundledHours,
        view.HourlyRate,
        view.Indexation,
        view.Contact,
        view.ManagedBy,
        view.AzureSurchargePercentage);

    // Deze twee heten EnvironmentFields en niet From: C# overlaadt niet op retourtype, en
    // From(OperatorContractView) bestaat al voor de contractvelden.
    //
    // LET OP — dit is een // en geen @* *@, en dat is geen smaak. Een razorcomment binnen @code
    // knipt het codeblok in twee stukken, en twee overloads van dezelfde methodenaam aan
    // weerszijden van die knip zien elkaar niet meer. Concreet: met een @* *@ hier vond
    // Changes(_customerConflict) hierboven alleen Changes(ContractDocument) en gaf CS1503 op een
    // aanroep die klopt. Zet commentaar in een codeblok dus altijd met // of ///.
    /// <summary>De omgevingsvelden zoals ze uit het viewmodel komen.</summary>
    private static CustomerFields EnvironmentFields(OperatorContractView view) => new()
    {
        Name = view.DisplayName,
        Environment = view.Environment,
        EnvironmentDetail = view.EnvironmentDetail,
        AzureScope = view.AzureScope,
        TelemetryEndpoint = view.TelemetryEndpoint,
        TelemetryDatabase = view.TelemetryDatabase,
    };

    /// <summary>De omgevingsvelden zoals ze uit een klantdocument komen.</summary>
    /// <remarks>
    /// Geen getallen en geen datums, dus hier is geen tussenlaag als
    /// <see cref="Fields(string?, string?, string?, string?, string?, string?, decimal?, decimal?, string?, string?, string?, decimal?)"/>
    /// nodig: vijf tekstvelden gaan ongewijzigd door. Het klant-id staat er niet op — dat is geen
    /// formulierwaarde maar de sleutel.
    /// </remarks>
    private static CustomerFields EnvironmentFields(CustomerDocument document) => new()
    {
        Name = document.Name,
        Environment = document.Environment,
        EnvironmentDetail = document.EnvironmentDetail,
        AzureScope = document.AzureScope,
        TelemetryEndpoint = document.TelemetryEndpoint,
        TelemetryDatabase = document.TelemetryDatabase,
    };

    /// <summary>De contractvelden zoals ze uit een document komen.</summary>
    /// <remarks>
    /// De ingangsdatum gaat ongewijzigd door: in het document staat hij al als <c>yyyy-MM-dd</c>,
    /// en dat is precies wat een datumveld wil hebben.
    /// </remarks>
    private static ContractFields From(ContractDocument document) => Fields(
        document.Number,
        document.Type,
        document.StartsOn,
        document.Term,
        document.NoticePeriod,
        document.Sla,
        document.BundledHours,
        document.HourlyRate,
        document.Indexation,
        document.Contact,
        document.ManagedBy,
        document.AzureSurchargePercentage);

    /// <summary>
    /// De enige plek waar waarden in formuliertekst worden omgezet.
    /// </summary>
    /// <remarks>
    /// <para>Twee bronnen — het viewmodel bij het laden, het document na een conflict of een gelukte
    /// schrijfactie — en één omzetting. Zouden ze elk hun eigen opmaak hebben, dan staat er na een
    /// conflict "125,50" tegenover "125.5" en meldt het scherm een wijziging die niemand heeft
    /// gemaakt.</para>
    ///
    /// <para>De drie bedragen zijn <c>decimal?</c>. <c>ContractText.Editable</c> maakt van
    /// <c>null</c> een leeg veld en van nul een "0" — niet allebei leeg, want dan zou het openen en
    /// meteen bewaren van een contract met een afgesproken nul die nul stil in "niet vastgelegd"
    /// veranderen, en zou <see cref="Changes(ContractDocument)"/> daar niets over melden.</para>
    /// </remarks>
    private static ContractFields Fields(
        string? number,
        string? type,
        string? startsOn,
        string? term,
        string? noticePeriod,
        string? sla,
        decimal? bundledHours,
        decimal? hourlyRate,
        string? indexation,
        string? contact,
        string? managedBy,
        decimal? surcharge) => new()
    {
        Number = number,
        Type = type,
        StartsOn = startsOn,
        Term = term,
        NoticePeriod = noticePeriod,
        Sla = sla,
        BundledHours = ContractText.Editable(bundledHours),
        HourlyRate = ContractText.Editable(hourlyRate),
        Indexation = indexation,
        Contact = contact,
        ManagedBy = managedBy,
        Surcharge = ContractText.Editable(surcharge),
    };

    /// <summary>
    /// Welke velden er zijn veranderd sinds dit formulier werd opgebouwd.
    /// </summary>
    /// <param name="document">Het document dat de opslag bij het conflict meestuurde.</param>
    /// <returns>Per gewijzigd veld het label, de oude en de nieuwe waarde.</returns>
    /// <remarks>
    /// De vergelijking gaat tegen <c>_original</c> en niet tegen wat de operator net heeft
    /// getypt. "Wat is er intussen veranderd" is een vraag over de ander, niet over jezelf.
    /// </remarks>
    private IReadOnlyList<FieldChange> Changes(ContractDocument document)
    {
        var current = From(document);
        var lijst = new List<FieldChange>(12);

        Compare("Contractnummer", _original.Number, current.Number);
        Compare("Soort", _original.Type, current.Type);
        Compare("Ingangsdatum", _original.StartsOn, current.StartsOn);
        Compare("Looptijd", _original.Term, current.Term);
        Compare("Opzegtermijn", _original.NoticePeriod, current.NoticePeriod);
        Compare("Urenbundel per maand", _original.BundledHours, current.BundledHours);
        Compare("Uurtarief buiten bundel", _original.HourlyRate, current.HourlyRate);
        Compare("Indexatie", _original.Indexation, current.Indexation);
        Compare("SLA", _original.Sla, current.Sla);
        Compare("Contactpersoon", _original.Contact, current.Contact);
        Compare("Beheerd door", _original.ManagedBy, current.ManagedBy);
        Compare("Opslag op Azure-kosten", _original.Surcharge, current.Surcharge);

        return lijst;

        void Compare(string label, string? before, string? after)
        {
            if (!string.Equals(before ?? string.Empty, after ?? string.Empty, StringComparison.Ordinal))
            {
                lijst.Add(new FieldChange(label, Readable(before), Readable(after)));
            }
        }
    }

    /// <summary>
    /// Welke omgevingsvelden er zijn veranderd sinds dit blok werd opgebouwd.
    /// </summary>
    /// <param name="document">Het klantdocument dat de opslag bij het conflict meestuurde.</param>
    /// <returns>Per gewijzigd veld het label, de oude en de nieuwe waarde.</returns>
    /// <remarks>
    /// Dezelfde vorm en dezelfde regel als bij het contract: de vergelijking gaat tegen
    /// <c>_customerOriginal</c> en niet tegen wat de operator net heeft getypt. "Wat is er intussen
    /// veranderd" is een vraag over de ander.
    ///
    /// <para>De labels zijn letterlijk die van de velden erboven. Een verschillenkaart die andere
    /// woorden gebruikt dan het formulier laat de operator zoeken naar het veld dat hij hoort te
    /// controleren.</para>
    /// </remarks>
    private IReadOnlyList<FieldChange> Changes(CustomerDocument document)
    {
        var current = EnvironmentFields(document);
        var lijst = new List<FieldChange>(6);

        Compare("Klantnaam", _customerOriginal.Name, current.Name);
        Compare("Omgeving", _customerOriginal.Environment, current.Environment);
        Compare(
            "Subscription en resource group",
            _customerOriginal.EnvironmentDetail,
            current.EnvironmentDetail);
        Compare("Azure-scope", _customerOriginal.AzureScope, current.AzureScope);
        Compare("Cosmos-endpoint", _customerOriginal.TelemetryEndpoint, current.TelemetryEndpoint);
        Compare("Databasenaam", _customerOriginal.TelemetryDatabase, current.TelemetryDatabase);

        return lijst;

        void Compare(string label, string? before, string? after)
        {
            if (!string.Equals(before ?? string.Empty, after ?? string.Empty, StringComparison.Ordinal))
            {
                lijst.Add(new FieldChange(label, Readable(before), Readable(after)));
            }
        }
    }

    /// <summary>Een lege waarde als woord, want een streepje in een zin leest als een gedachtestreep.</summary>
    private static string Readable(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "leeg" : value;

    /// <summary>Witruimte wordt <c>null</c>: een leeg veld is geen lege tekst maar geen waarde.</summary>
    private static string? NullIfBlank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string By(string? actor) =>
        string.IsNullOrWhiteSpace(actor) ? string.Empty : $" door {actor}";

    /// <summary>De tooltip bij de kolom "Vastgelegd": wanneer, en door welke operator.</summary>
    private static string GrantedTitle(OperatorAccessRow row) =>
        $"vastgelegd {TimeFormat.Absolute(row.GrantedAt)}{By(row.GrantedBy)}";
}
