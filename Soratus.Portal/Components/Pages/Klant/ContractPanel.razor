    /// De versie waarop dit formulier is gebaseerd, of <c>null</c> als er nog geen contract is.
    /// </summary>
    /// <remarks>
    /// <c>null</c> betekent "dit contract wordt aangemaakt" en niet "sla de controle over": ook
    /// dan levert een ander die net eerder was een conflict op.
    /// </remarks>
    private string? _etag;

    private bool _hasContract;
    private DateTimeOffset? _changedAt;
    private string? _changedBy;

    private FormSaveState _contractState = FormSaveState.Idle;
    private string? _contractError;
    private string? _hoursError;
    private string? _rateError;
    private string? _surchargeError;

    private ContractDocument? _conflict;
    private IReadOnlyList<FieldChange> _changes = [];

    private CustomerFields _customer = new();
    private CustomerFields _customerOriginal = new();

    /// <summary>
    /// De versie van het klantdocument waarop dit blok is gebaseerd, of <c>null</c> als er nog geen
    /// klantdocument is.
    /// </summary>
    /// <remarks>
    /// Een eigen etag naast <see cref="_etag"/>, want het zijn twee documenten. Eén etag voor beide
