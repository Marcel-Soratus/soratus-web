    private string? _customerETag;

    private bool _hasCustomerDocument;
    private bool _isInternal;
    private DateTimeOffset? _customerChangedAt;
    private string? _customerChangedBy;

    private FormSaveState _customerState = FormSaveState.Idle;
    private string? _customerError;
    private string? _nameError;
    private string? _scopeError;

