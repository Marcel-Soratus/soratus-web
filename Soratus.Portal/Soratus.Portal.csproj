<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>soratus-portal</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Dezelfde versie als Soratus.Web, waar dit pad vandaag in productie loopt
      (Services/LeadSink.cs). Twee versies van dezelfde mailbibliotheek in één repo zou betekenen
      dat het bewezen pad en het nieuwe pad niet meer hetzelfde pad zijn.
    -->
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.10.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.10.0" />
    <!--
      De Cosmos-SDK levert Newtonsoft.Json sinds 3.6x niet meer zelf mee en eist een expliciete
      verwijzing. Wij serialiseren met System.Text.Json (zie CosmosAgentTelemetryStore), maar de
      SDK gebruikt Newtonsoft nog op interne paden.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soratus.Agents.Contracts\Soratus.Agents.Contracts.csproj" />
    <!--
      Het portaal lás documentvormen en schreef ze niet: de kostencollector en de storingsmelder
      draaien hier, maar bestonden niet als agent in ons eigen overzicht. Met deze verwijzing meldt
      het portaal zijn eigen beheeragents langs hetzelfde contract als de agents van een klant —
      zelfde bibliotheek, zelfde documentvorm, zelfde statusregel.

      Alleen de telemetriebibliotheek en niet Soratus.Agents.AspNetCore: die laatste bestaat om
      inkomende verzoeken als run vast te leggen, en deze twee agents draaien op een klok. Zie
      Platform/PlatformAgents.cs.
    -->
    <ProjectReference Include="..\Soratus.Agents.Telemetry\Soratus.Agents.Telemetry.csproj" />
    <!--
      De AI-eerstelijn van §3.8. De verwijzing loopt deze kant op en niet de andere, en dat is de kern
      van het ontwerp: dat project kent SupportGround niet, dus het kan geen grondslag maken en geen
      feit teruggeven. Het krijgt regels tekst en het geeft een geheel getal terug — de plaats van het
      gekozen feit in de lijst die het van ons kreeg.

      Beide richtingen tegelijk (het model buiten de assembly én de registratie in Program.cs, zoals
      §46.13 voorschreef) is niet te bouwen: MSBuild weigert een circulaire projectverwijzing met
      MSB4006, ook met ReferenceOutputAssembly="false". Gemeten; zie §47.1 van
      docs/agent-portal/fase-0-afwijkingen.md.
    -->
    <ProjectReference Include="..\Soratus.Support.FirstLine\Soratus.Support.FirstLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Een webproject haalt Microsoft.Extensions.Logging via de impliciete usings binnen, en
      daar zit ook een LogLevel. Zonder deze alias is elke verwijzing naar LogLevel ambigu, en
      dat wringt in elk bestand dat met logregels werkt — dat is in dit portaal de kern van het
      werk. Eén alias op projectniveau in plaats van een using-regel per bestand.

      LogLevel betekent hier dus het niveau van een agent-logregel. Wil je dat van het
      logframework, schrijf dan Microsoft.Extensions.Logging.LogLevel voluit.
    -->
    <Using Include="Soratus.Agents.Contracts.LogLevel" Alias="LogLevel" />
  </ItemGroup>

  <ItemGroup>
    <!--
      De store, de scope-resolver en de viewmodelbouwer zijn internal, en dat blijven ze: buiten het
      portaal hoort niemand een scope te kunnen maken. Het testproject moet ze wel kunnen aanroepen,
      anders zijn juist de klassen waar de autorisatie in zit de enige die niet getest worden.
    -->
    <InternalsVisibleTo Include="Soratus.Portal.Tests" />
  </ItemGroup>

</Project>
