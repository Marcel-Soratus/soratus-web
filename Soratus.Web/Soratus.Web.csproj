    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <!-- Transitief via Microsoft.AspNetCore.OpenApi, dat 2.0.0 binnenhaalt. Die versie
         heeft GHSA-v5pm-xwqc-g5wc (NU1903); 2.7.5+ is gepatcht. Weghalen zodra
         Microsoft.AspNetCore.OpenApi zelf een gepatchte versie meebrengt. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
  </ItemGroup>

</Project>
