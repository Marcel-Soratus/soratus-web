@inject IOptions<BrandOptions> Brand

<section class="hero" id="top">
    <div class="wrap">
        <Eyebrow />

        <h1 class="h1 hero-h1 reveal" data-comment-anchor="hero-h1">
            <span class="strike" data-text="Software laten bouwen">Software laten bouwen</span><br />
            is <span class="italic">voorbij</span>.<br />
            Wij bouwen <span class="grad">intelligentie</span>.
        </h1>

        <div class="hero-terminal reveal" data-comment-anchor="hero-terminal">
            <header class="ht-bar">
                <span class="ht-dot ht-dot-r" aria-hidden="true"></span>
                <span class="ht-dot ht-dot-y" aria-hidden="true"></span>
                <span class="ht-dot ht-dot-g" aria-hidden="true"></span>
                <span class="ht-title">tempo.soratus.run</span>
                <span class="ht-status" aria-label="online">
                    <span class="ht-status-dot"></span>online
                </span>
            </header>

            <div class="ht-body">
                <p class="ht-intro">Geen marketing — gewoon wat we doen:</p>

                <ul class="ht-list">
                    <li>AI-agents bouwen die in <em>productie</em> staan, niet in een pitchdeck</li>
                    <li>Custom software in <em>14 dagen</em> live, vaste prijs. Daarna blijven we meelopen</li>
                    <li>Diepe integratie met Exact, AFAS, Salesforce, HubSpot</li>
                </ul>

                <p class="ht-prompt">
                    Wat brengt je vandaag? Klik iets, of typ je eigen vraag.
                </p>

                <div class="ht-chips">
                    <button class="ht-chip askable" data-chat-prompt="Wat kost een AI-agent?" type="button">
                        Wat kost een AI&#8209;agent?
                    </button>
                    <button class="ht-chip askable" data-chat-prompt="Hoe snel kan iets live staan?" type="button">
                        Hoe snel kan iets live?
                    </button>
                    <button class="ht-chip askable" data-chat-prompt="Werkt dit ook met onze stack? We gebruiken bijvoorbeeld..." type="button">
                        Werkt dit met onze stack?
                    </button>
                    <button class="ht-chip ht-chip-prime askable" data-chat-prompt="Ik heb iets specifieks waar ik mee zit" type="button">
                        Ik heb iets specifieks →
                    </button>
                </div>
            </div>
        </div>

        <div class="meta-row reveal">
            <span><Pip Color="var(--blue-2)" /> @Brand.Value.Stats.ActiveProjects actieve projecten</span>
            <span><Pip Color="var(--green)" /> @Brand.Value.Stats.AgentsInProduction AI-agents in productie</span>
            <span><Pip Color="var(--warn)" /> Antwoord &lt; @Brand.Value.Stats.ResponseTimeHours uur</span>
        </div>
    </div>
</section>
