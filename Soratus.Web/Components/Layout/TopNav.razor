<nav class="top">
    <div class="wrap nav-row">
        <Wordmark />
        <div class="nav-links">
            @* Ankers in paginavolgorde. Cases is de enige echte paginalink en
               staat daarom achteraan, net voor de contact-CTA. *@
            <a href="/#wat">Wat we doen</a>
            <a href="/#hoe">Hoe</a>
            <a href="/#branches">Branches</a>
            <a href="/#bewijs">Bewijs</a>
            <a href="/cases">Cases</a>
            <a href="/partner">Partner</a>
            <a href="/#contact">Contact</a>
        </div>
        <div class="nav-cta">
            @* Bewust een stille tekstlink links van de CTA: wie ons nog niet kent
               moet eerst bij het gesprek uitkomen, niet bij een inlogscherm.
               Zelfde tabblad, want de Entra-redirect keert hier toch niet terug. *@
            <a class="nav-login" href="https://portal.soratus.com">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
                Inloggen
            </a>
            <Button Variant="glow" ShowDot="true" Attrs="@(new Dictionary<string,object>{ ["onclick"] = "window.soratus && soratus.openChat()" })">
                Praat met onze AI
            </Button>
        </div>
        <button class="nav-burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="navSheet"
                onclick="window.soratus && soratus.toggleNavSheet()">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<div class="nav-sheet" id="navSheet" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
    <button class="nav-sheet-close" aria-label="Sluit menu" onclick="window.soratus && soratus.closeNavSheet()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg>
    </button>
    <div class="nav-sheet-panel">
        <a class="sheet-link" href="/#wat" onclick="window.soratus && soratus.closeNavSheet()">Wat we doen</a>
        <a class="sheet-link" href="/#hoe" onclick="window.soratus && soratus.closeNavSheet()">Hoe</a>
        <a class="sheet-link" href="/#branches" onclick="window.soratus && soratus.closeNavSheet()">Branches</a>
        <a class="sheet-link" href="/#bewijs" onclick="window.soratus && soratus.closeNavSheet()">Bewijs</a>
        <a class="sheet-link" href="/cases" onclick="window.soratus && soratus.closeNavSheet()">Cases</a>
        <a class="sheet-link" href="/partner" onclick="window.soratus && soratus.closeNavSheet()">Partner</a>
        <a class="sheet-link" href="/#contact" onclick="window.soratus && soratus.closeNavSheet()">Contact</a>
        <div style="margin-top: 24px;">
            <Button Variant="glow" ShowDot="true"
                    Attrs="@(new Dictionary<string,object>{ ["onclick"] = "window.soratus && soratus.closeNavSheet(); window.soratus && soratus.openChat();", ["style"] = "width:100%;justify-content:center" })">
                Praat met onze AI
            </Button>
        </div>
        <a class="sheet-login" href="https://portal.soratus.com">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
            Inloggen
        </a>
    </div>
</div>
