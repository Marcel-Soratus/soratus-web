@inject IOptions<CompanyOptions> Company
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Titel komt per pagina uit <PageTitle> via <HeadOutlet />. Geen vaste
       <title> hier: die zou als eerste titel-element de paginatitels overrulen. *@
    <base href="/" />
    <meta name="theme-color" content="#13162a" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/favicon-180.png" />
    <link rel="canonical" href="@Company.Value.Url" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Sora:wght@200;300;400;500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/reveal.css"]" />
    <link rel="stylesheet" href="@Assets["css/cases.css"]" />

    <ImportMap />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <div id="blazor-error-ui" data-nosnippet>
        Er ging iets mis. <a href="." class="reload">Herlaad</a>
        <span class="dismiss">×</span>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script type="module" src="@Assets["js/soratus.js"]"></script>

    @* Microsoft Clarity — session replay + heatmaps (no cookies set by default, uses LocalStorage).
       Twee filters, zodat er alleen echt publiek in de statistieken komt:
       1. Niet in Development, dus debug-sessies leveren geen opnames op.
       2. Alleen op de canonieke host. Dat sluit localhost uit bij een lokale
          productie-run, maar ook de standaard Azure-hostnaam
          (app-soratus-prod.azurewebsites.net) en eventuele deployment-slots.
          Die worden continu door bots afgescand en vervuilen anders de data. *@
    @if (!Env.IsDevelopment())
    {
        <script>
            (function(c,l,a,r,i,t,y){
                if (l.location.hostname !== "@(new Uri(Company.Value.Url).Host)") return;
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "mk41n6gnwb");
        </script>
    }
</body>
</html>
